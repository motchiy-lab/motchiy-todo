# MongoDBが同じPCで動作している場合
MONGODB_URI=mongodb://127.0.0.1:27017/motchiy_todo

# 32バイト以上のランダムな秘密鍵に置き換える
JWT_SECRET=ここにランダムな秘密鍵を設定

# ResendのAPIキーと、Resendで認証済みのドメインの送信元アドレス
RESEND_API_KEY=re_ここにResendのAPIキーを設定
EMAIL_FROM=Motchiy ToDo <noreply@example.com>

# Web版を使う場合はWebアプリのオリジンを指定（例：https://todo.motchiy.com）
# 複数指定する場合はカンマ区切り
WEB_ORIGINS=
